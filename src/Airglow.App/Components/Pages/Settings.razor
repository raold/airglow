@page "/settings"
@using Airglow.Core.Config
@inject IServiceClient Client

<h1 class="page-title">Settings</h1>

@if (Draft.Value is not { } config)
{
    <LoadBanner Draft="Draft" Loaded="Refresh" />
}
else
{
    <section class="panel">
        <h2 class="panel-title">Engine</h2>
        <div class="form-grid">
            <label for="tick">Update interval (ms)</label>
            <input id="tick" type="number" min="250" max="5000" step="250" @bind="Tick" @bind:event="onchange" />
            <label for="failsafe-percent">Failsafe speed %</label>
            <input id="failsafe-percent" type="number" min="50" max="100" @bind="FailsafePercent" @bind:event="onchange" />
            <label for="failsafe-after">Failsafe after (s)</label>
            <input id="failsafe-after" type="number" min="1" max="60" step="0.5" @bind="FailsafeAfter" @bind:event="onchange" />
            <label for="shutdown-percent">Shutdown speed %</label>
            <input id="shutdown-percent" type="number" min="30" max="100" @bind="ShutdownPercent" @bind:event="onchange" />
        </div>
    </section>

    <section class="panel">
        <h2 class="panel-title">Lian Li groups</h2>
        <div class="form-grid">
            @foreach (var group in config.LianLiGroups)
            {
                var index = group.Index;
                <label for="@($"group-name-{index}")">Group @(index + 1) name</label>
                <input id="@($"group-name-{index}")" type="text" value="@group.Name"
                       @onchange="e => UpdateGroup(index, g => g with { Name = e.Value?.ToString() ?? string.Empty })" />
                <label for="@($"group-fans-{index}")">Group @(index + 1) fans</label>
                <input id="@($"group-fans-{index}")" type="number" min="0" max="4" value="@group.FanCount"
                       @onchange="e => UpdateGroup(index, g => g with { FanCount = int.TryParse(e.Value?.ToString(), out var n) ? n : g.FanCount })" />
            }
        </div>
    </section>

    <section class="panel">
        <h2 class="panel-title">Startup</h2>
        @if (_managedByInstaller)
        {
            <label class="check"><input id="autostart" type="checkbox" checked disabled /> Starts at sign-in (set by the installer)</label>
        }
        else
        {
            <label class="check"><input id="autostart" type="checkbox" checked="@_autostart" @onchange="OnAutostartChanged" /> Start airglow with Windows</label>
        }
    </section>

    <SaveBar Draft="Draft" Changed="Refresh" />
}

@code {
    private ConfigDraft Draft = default!;

    // Bound to the child components so the page re-renders after they save, revert or reload.
    private void Refresh()
    {
    }

    private bool _autostart;
    private bool _managedByInstaller;

    protected override async Task OnInitializedAsync()
    {
        Draft = new ConfigDraft(Client);
        try
        {
            _managedByInstaller = Autostart.IsManagedByInstaller;
            _autostart = Autostart.IsEnabled;
        }
        catch (Exception)
        {
            _autostart = false;
        }
        await Draft.LoadAsync();
    }

    private void UpdateEngine(Func<EngineSettings, EngineSettings> change) =>
        Draft.Update(c => c with { Engine = change(c.Engine) });

    private void UpdateGroup(int index, Func<LianLiGroup, LianLiGroup> change) =>
        Draft.Update(c => c with { LianLiGroups = [.. c.LianLiGroups.Select(g => g.Index == index ? change(g) : g)] });

    private int Tick { get => Draft.Value!.Engine.TickMilliseconds; set => UpdateEngine(e => e with { TickMilliseconds = value }); }

    private int FailsafePercent { get => Draft.Value!.Engine.FailsafePercent; set => UpdateEngine(e => e with { FailsafePercent = value }); }

    private double FailsafeAfter { get => Draft.Value!.Engine.FailsafeAfterSeconds; set => UpdateEngine(e => e with { FailsafeAfterSeconds = value }); }

    private int ShutdownPercent { get => Draft.Value!.Engine.ShutdownPercent; set => UpdateEngine(e => e with { ShutdownPercent = value }); }

    private void OnAutostartChanged(ChangeEventArgs e)
    {
        var enabled = (bool)(e.Value ?? false);
        try
        {
            Autostart.Set(enabled);
            _autostart = enabled;
            Draft.Errors = [];
        }
        catch (Exception ex)
        {
            Draft.Errors = [$"Couldn't change the startup setting: {ex.Message}"];
        }
    }
}
